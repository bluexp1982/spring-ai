# 环境变量样例：复制为 .env 后填入真实值，或直接 export 到当前 shell。
# 注意：本项目不会自动加载 .env，Spring Boot 读取的是进程环境变量。
# .env 已被 .gitignore 忽略，请勿提交真实密钥。

# ===== 必填 =====
# 阿里云百炼 API Key（对话 + 向量化共用），缺失会导致调用报 401
BAILIAN_API_KEY=sk-xxx
# PostgreSQL 口令（用户名/地址/库名见下方可选变量）
DB_PASSWORD=postgres

# ===== 数据库（可选，括号内为默认值）=====
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=spring-ai
# DB_USERNAME=postgres

# ===== 对话模型（可选）=====
# openai（默认，走百炼千问）或 deepseek
# CHAT_PROVIDER=openai
# CHAT_MODEL=qwen3.8-flash
# DEEPSEEK_API_KEY=sk-xxx
# DEEPSEEK_CHAT_MODEL=deepseek-flash
# 百炼 OpenAI 兼容地址，使用专属业务空间时覆盖
# BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== 向量化 / RAG（可选）=====
# EMBEDDING_MODEL=qwen3.7-text-embedding
# EMBEDDING_DIMENSIONS=1024
# MILVUS_HOST=localhost
# MILVUS_PORT=19530
# MILVUS_USERNAME=root
# MILVUS_PASSWORD=Milvus

# ===== 长期记忆（可选）=====
# 记忆根目录（相对进程工作目录），默认 data/memory
# MEMORY_DIR=data/memory

# ===== 认证（生产必填）=====
# 用 `openssl rand -base64 32` 生成，至少 32 字节
JWT_SECRET=please-change-me-to-a-random-32-bytes-secret

# ===== MCP 外部工具（可选）=====
# 高德地图 MCP Server 的 Key，缺失时地图类工具不可用
AMAP_MAPS_API_KEY=
